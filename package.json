{
  "name": "verteles",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --mode web",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --trace off",
    "build:tizen": "vite build --mode tizen",
    "tizen:package": "node --env-file-if-exists=.env.local scripts/tizen.mjs package",
    "tizen:install": "node --env-file-if-exists=.env.local scripts/tizen.mjs install",
    "tizen:run": "node --env-file-if-exists=.env.local scripts/tizen.mjs run"
  },
  "dependencies": {
    "hls.js": "^1.7.4",
    "solid-js": "~1.9.20"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.7",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.4.0",
    "vite-plugin-solid": "^2.11.17",
    "vitest": "^5.1.2"
  }
}
